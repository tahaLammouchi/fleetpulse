# Python
__pycache__/
*.py[cod]
*$py.class

# Environnements virtuels
venv/
.venv/
env/
ENV/

# Distribution / packaging
build/
dist/
*.egg-info/

# Tests / couverture
.pytest_cache/
.coverage
htmlcov/

# Jupyter Notebooks (checkpoints, pas les .ipynb eux-mêmes)
.ipynb_checkpoints/

# Modèles ML entraînés (volumineux, ne pas versionner dans Git classique)
*.joblib
*.pkl
*.onnx
/models/*.joblib
!/models/.gitkeep

# Datasets générés localement (volumineux, reproductibles via script)
/data/*.csv
!/data/.gitkeep

# Variables d'environnement (secrets)
.env
.env.local

# IDE
.idea/
.vscode/

# OS
.DS_Store
Thumbs.db

# Logs
*.log